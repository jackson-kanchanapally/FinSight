DATABASE_NAME=finsight
DATABASE_USER=finsight
DATABASE_PASSWORD=finsight_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432

# The fixture source contains clearly labeled example disclosures, not live filings.
EVENT_SOURCE_MODE=fixture
EVENT_MONITOR_ENABLED=false
EVENT_MONITOR_INTERVAL_MINUTES=30

# In live mode, NSE RSS covers registered NSE-listed companies automatically.
# Company IR adapters remain source-specific.
# BSE remains a documented placeholder until a suitable official feed is verified.
NSE_SOURCE_ENABLED=true
BSE_SOURCE_ENABLED=false
COMPANY_IR_SOURCE_ENABLED=true
LIVE_SOURCE_TIMEOUT_SECONDS=15

# Official NSE MCP EOD (personal informational use) is the preferred provider.
# Opt in to scheduled refresh; manual refresh is available without it.
MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=nse_mcp
MARKET_DATA_TIMEOUT_SECONDS=12
MARKET_DATA_REFRESH_HOUR=18
MARKET_DATA_REFRESH_MINUTE=30
MARKET_LENS_TOLERANCE_PCT=5
# Optional secondary documented provider; requires BSE code and API key.
ALPHA_VANTAGE_API_KEY=

# Local analyst: install Ollama, pull this model, and leave Ollama running.
# No paid API is used. Change model without changing almonds business logic.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
QUARTERLY_REVIEW_TIMEOUT_SECONDS=360
OLLAMA_NUM_CTX=8192
AI_TEMPERATURE=0.1
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_DOCUMENT_CHARS=1800

# Local company memory. Start the compose Qdrant service or reuse a local instance.
# ollama pull nomic-embed-text
COMPANY_MEMORY_ENABLED=true
QDRANT_BASE_URL=http://localhost:6333
MEMORY_COLLECTION=almonds_company_memory_v1
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_TIMEOUT_SECONDS=5
MEMORY_EMBEDDING_TIMEOUT_SECONDS=45
MEMORY_CHUNK_CHARS=1600
MEMORY_OVERLAP_CHARS=160
MEMORY_CONTEXT_CHARS=2400
MEMORY_MIN_SCORE=0.35
