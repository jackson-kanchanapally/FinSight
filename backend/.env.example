DATABASE_NAME=finsight
DATABASE_USER=finsight
DATABASE_PASSWORD=finsight_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Automatic research never schedules synthetic fixtures. Use live or none.
RESEARCH_AUTOMATION_ENABLED=true
RESEARCH_POLL_SECONDS=60
# Bound each worker cycle; accommodates every registered portfolio entry.
RESEARCH_BATCH_SIZE=12
EVENT_SOURCE_MODE=live
EVENT_MONITOR_ENABLED=false
EVENT_MONITOR_INTERVAL_MINUTES=10

# In live mode, NSE RSS covers registered NSE-listed companies automatically.
# Company IR adapters remain source-specific.
# BSE remains a documented placeholder until a suitable official feed is verified.
NSE_SOURCE_ENABLED=true
BSE_SOURCE_ENABLED=false
COMPANY_IR_SOURCE_ENABLED=true
LIVE_SOURCE_TIMEOUT_SECONDS=15

# Optional personal Telegram alerts. Run backend/scripts/setup_telegram.py.
# Secrets stay on the backend; do not commit your private .env.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_POLL_SECONDS=5
# Skip old archive imports when creating alerts.
TELEGRAM_MAX_EVENT_AGE_HOURS=48
# Automatic alerts are limited to these investor-relevant disclosure types.
# Edit the comma-separated list to change what counts as important for you.
TELEGRAM_IMPORTANT_EVENT_TYPES=FINANCIAL_RESULTS,DIVIDEND,ORDER_WIN,ORDER_CANCELLATION,ACQUISITION,DIVESTMENT,CAPEX,MANAGEMENT_CHANGE,AUDITOR_CHANGE,BUYBACK,FUND_RAISE,CREDIT_RATING,PROMOTER_TRANSACTION,PLEDGE,REGULATORY,LITIGATION

# Optional remote reports: provision an HTTPS reverse proxy that exposes ONLY
# /api/reports/earnings/* to this loopback service. Do not expose the local API.
# Leave empty until a remotely reachable route exists. No localhost links emitted.
REPORT_PUBLIC_BASE_URL=
# Generate a separate random secret of at least 32 characters; not the bot token.
REPORT_ACCESS_SECRET=
REPORT_LINK_TTL_SECONDS=86400

# Official NSE MCP EOD (personal informational use) is the preferred provider.
# Autonomous research schedules this free provider independently of the legacy timer.
MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=nse_mcp
MARKET_DATA_TIMEOUT_SECONDS=12
MARKET_DATA_REFRESH_HOUR=18
MARKET_DATA_REFRESH_MINUTE=30
MARKET_LENS_TOLERANCE_PCT=5
# Optional secondary documented provider; requires BSE code and API key.
ALPHA_VANTAGE_API_KEY=

# Local analyst: install Ollama, pull this model, and leave Ollama running.
# No paid API is used. Change model without changing almonds business logic.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
QUARTERLY_REVIEW_TIMEOUT_SECONDS=360
OLLAMA_NUM_CTX=8192
AI_TEMPERATURE=0.1
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_DOCUMENT_CHARS=1800

# Local company memory. Start the compose Qdrant service or reuse a local instance.
# ollama pull nomic-embed-text
COMPANY_MEMORY_ENABLED=true
QDRANT_BASE_URL=http://localhost:6333
MEMORY_COLLECTION=almonds_company_memory_v1
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_TIMEOUT_SECONDS=5
MEMORY_EMBEDDING_TIMEOUT_SECONDS=45
MEMORY_CHUNK_CHARS=1600
MEMORY_OVERLAP_CHARS=160
MEMORY_CONTEXT_CHARS=2400
MEMORY_MIN_SCORE=0.35

# Phase 8.3: frozen at expectation capture; later changes do not rescore history.
EXPECTATION_MET_TOLERANCE_PCT=5
EXPECTATION_PARTIAL_TOLERANCE_PCT=10
EXPECTATION_PERCENTAGE_TOLERANCE_PP=0.5
EXPECTATION_MIN_SAMPLE=20
